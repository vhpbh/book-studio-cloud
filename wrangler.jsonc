{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "book",
  "main": "src/index.js",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "browser": {
    "binding": "BROWSER"
  },
  "r2_buckets": [
    {
      "binding": "BOOK_FILES"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "BOOK_JOBS"
    }
  ]
}
